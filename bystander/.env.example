# Copy to .env and fill in, then: set -a; . ./.env; set +a; npm start
# Everything is optional. With nothing set, the coach works and the AI caller
# rings the web dispatcher console, answering with built-in rules.

# Claude answers the dispatcher's questions
ANTHROPIC_API_KEY=
# BYSTANDER_MODEL=claude-opus-5-5
# BYSTANDER_EFFORT=low

# Real phone calls through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The teammate playing the dispatcher. Full international format. Never 911.
BYSTANDER_DISPATCH_NUMBER=
# Public HTTPS address of this server (your tunnel URL), no trailing slash
PUBLIC_URL=
# relay (ConversationRelay, streaming) or gather (<Say>/<Gather> turns)
# BYSTANDER_VOICE_MODE=relay

# Fixed key for the dispatcher console link (random on each start if unset)
# BYSTANDER_DISPATCH_KEY=
# Every call says "training demo" unless this is 0
# BYSTANDER_DEMO=1
